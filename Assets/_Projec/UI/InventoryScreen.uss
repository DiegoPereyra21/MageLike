.inv-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    min-height: 100%;
    justify-content: center;
    align-items: center;
    display: none;
}

.inv-panel {
    -unity-font-definition: url("/Assets/_Projec/Fonts/Manrope-Regular.ttf");
    flex-direction: column;
    background-color: rgb(14, 14, 24);
    border-width: 1px;
    border-color: rgba(68, 70, 88, 0.4);
    border-radius: 16px;
    padding: 44px 50px;
}

.inv-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 22px;
}

.inv-title {
    -unity-font-definition: url("/Assets/_Projec/Fonts/Cinzel-Medium.ttf");
    color: rgb(237, 238, 245);
    font-size: 28px;
}

.inv-hint-corner {
    color: rgb(97, 98, 111);
    font-size: 14px;
}

.inv-columns {
    flex-direction: row;
}

.column {
    margin: 0 20px;
}

.equipment-column {
    margin-left: 0;
}

.container-column {
    display: none; /* solo visible en modo saqueo */
}

.column-title {
    color: rgb(97, 98, 111);
    font-size: 15px;
    letter-spacing: 1px;
    margin-bottom: 10px;
}

/* ---------- Equipamiento ---------- */

.equipment-slots {
    flex-direction: column;
    width: 380px;
}

.equip-slot {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 9px 4px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(48, 49, 66, 0.25);
}

.equip-slot.no-border {
    border-bottom-width: 0;
}

.equip-slot-label {
    color: rgb(111, 113, 125);
    font-size: 17px;
    width: auto;
}

.equip-row-item {
    flex-direction: row;
    align-items: center;
}

.accent-dot {
    width: 10px;
    height: 10px;
    border-radius: 6px;
}

/* ---------- Pockets ---------- */

.pockets-and-usables {
    flex-direction: column;
}

.pockets-row {
    flex-direction: row;
}

.pocket-column {
    margin-right: 26px;
}

.backpack-grid {
    flex-direction: row;
    flex-wrap: wrap;
    width: 296px;
}

.item-slot {
    width: 60px;
    height: 60px;
    margin: 7px;
    background-color: rgba(29, 30, 41, 0.4);
    border-width: 1px;
    border-color: rgba(55, 57, 74, 0.35);
    border-radius: 6px;
    justify-content: center;
    align-items: center;
    overflow: hidden;
}

.item-slot:hover {
    border-color: rgba(237, 238, 245, 0.5);
}

.item-name {
    color: rgb(227, 228, 235);
    font-size: 13px;
    -unity-text-align: middle-center;
    white-space: normal;
    width: 100%;
    padding: 2px;
}

.item-qty {
    position: absolute;
    bottom: 2px;
    right: 4px;
    color: white;
    font-size: 12px;
    -unity-font-style: bold;
}

/* ---------- Usables (placeholder visual, sin lógica todavía) ---------- */

.usable-slots {
    flex-direction: row;
    margin-top: 22px;
}

.usable-slot {
    width: 92px;
    height: 92px;
    margin: 7px;
    background-color: rgba(29, 30, 41, 0.4);
    border-width: 1px;
    border-color: rgba(55, 57, 74, 0.35);
    border-radius: 6px;
    position: relative;
}

.usable-key-hint {
    position: absolute;
    bottom: 4px;
    right: 6px;
    color: rgb(97, 98, 111);
    font-size: 12px;
}

/* ---------- Acentos por slot / tipo de item (igual que Stash) ---------- */

.accent-dot.accent-green   { background-color: rgb(103, 210, 131); }
.accent-dot.accent-cyan    { background-color: rgb(62, 204, 226); }
.accent-dot.accent-violet  { background-color: rgb(181, 139, 249); }
.accent-dot.accent-gold    { background-color: rgb(228, 183, 80); }
.accent-dot.accent-amber   { background-color: rgb(237, 131, 94); }
.accent-dot.accent-loot    { background-color: rgb(226, 73, 71); }

.item-slot.accent-green  { background-color: rgba(103, 210, 131, 0.18); border-color: rgba(103, 210, 131, 0.55); }
.item-slot.accent-cyan   { background-color: rgba(62, 204, 226, 0.18); border-color: rgba(62, 204, 226, 0.55); }
.item-slot.accent-violet { background-color: rgba(181, 139, 249, 0.18); border-color: rgba(181, 139, 249, 0.55); }
.item-slot.accent-gold   { background-color: rgba(228, 183, 80, 0.18); border-color: rgba(228, 183, 80, 0.55); }
.item-slot.accent-amber  { background-color: rgba(237, 131, 94, 0.18); border-color: rgba(237, 131, 94, 0.55); }
.item-slot.accent-loot   { background-color: rgba(226, 73, 71, 0.18); border-color: rgba(226, 73, 71, 0.6); }

/* ---------- Nombre de item dentro de una fila de equipo ---------- */

.equip-slot .equip-item-name {
    color: rgb(227, 228, 235);
    font-size: 16px;
    -unity-font-style: bold;
    margin-left: 8px;
}

.hint {
    color: rgb(97, 98, 111);
    font-size: 14px;
    -unity-font-style: italic;
    margin-top: 20px;
    -unity-text-align: middle-center;
}

.drag-ghost {
    position: absolute;
    width: 60px;
    height: 60px;
    background-color: rgba(40, 40, 60, 0.95);
    border-width: 1px;
    border-color: rgba(237, 238, 245, 0.6);
    border-radius: 6px;
    justify-content: center;
    align-items: center;
}