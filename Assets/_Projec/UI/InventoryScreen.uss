.inv-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    min-height: 100%;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.55);
    display: none;
}

.inv-panel {
    flex-direction: row;
    background-color: rgba(255, 0, 0, 0.9);
    min-height: 400px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.25);
    border-radius: 10px;
    padding: 18px;
}

.column {
    margin: 8px;
    min-width: 200px;
}

.container-column {
    display: none; /* solo visible en modo saqueo */
}

.column-title {
    color: white;
    -unity-font-style: bold;
    font-size: 16px;
    margin-bottom: 10px;
    -unity-text-align: middle-center;
}

.equipment-slots {
    flex-direction: column;
}

.backpack-grid {
    flex-direction: row;
    flex-wrap: wrap;
    width: 320px;
}

.item-slot {
    width: 58px;
    height: 58px;
    margin: 3px;
    background-color: rgba(12, 12, 20, 0.9);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.2);
    border-radius: 6px;
    justify-content: center;
    align-items: center;
    overflow: hidden;
}

.item-slot:hover {
    border-color: rgba(255, 255, 255, 0.6);
}

.equip-slot {
    flex-direction: row;
    width: 247px;
    height: 46px;
    margin: 3px;
    background-color: rgba(12, 12, 20, 0.9);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.2);
    border-radius: 6px;
    align-items: center;
    padding-left: 8px;
    overflow: hidden;
}
.equip-slot-label {
    color: rgba(255, 255, 255, 0.5);
    font-size: 11px;
    width: 70px;
}

.item-name {
    color: white;
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
    width: 100%;
    padding: 2px 3px;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.95);
}

.item-qty {
    position: absolute;
    bottom: 2px;
    right: 4px;
    color: white;
    font-size: 10px;
    -unity-font-style: bold;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.95);
}

.drag-ghost {
    position: absolute;
    width: 56px;
    height: 56px;
    background-color: rgba(40, 40, 60, 0.95);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.7);
    border-radius: 6px;
    justify-content: center;
    align-items: center;
}

.equip-slot > .item-name {
    width: auto;
    flex-grow: 1;
    flex-shrink: 1;
    -unity-text-align: middle-left;
    padding: 2px 4px;
}

/* Colores por categoría (borde izquierdo) */
.cat-material { border-left-color: rgb(150, 110, 70); border-left-width: 4px; }
.cat-resource { border-left-color: rgb(200, 60, 60); border-left-width: 4px; }
.cat-equipment { border-left-color: rgb(70, 130, 200); border-left-width: 4px; }
.cat-catalyst { border-left-color: rgb(170, 90, 200); border-left-width: 4px; }
.cat-consumable { border-left-color: rgb(80, 180, 100); border-left-width: 4px; }
.cat-misc { border-left-color: rgba(255,255,255,0.3); border-left-width: 4px; }