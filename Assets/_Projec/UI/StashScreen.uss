.stash-root {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    background-color: rgb(4, 4, 9);
    display: none;
}

.stash-panel {
    -unity-font-definition: url("/Assets/_Projec/Fonts/Manrope-Regular.ttf");
    background-color: rgb(18, 19, 29);
    border-width: 1px;
    border-color: rgba(68, 70, 88, 0.4);
    border-radius: 16px;
    padding: 42px 52px;
    align-items: center;
}

.stash-title {
    -unity-font-definition: url("/Assets/_Projec/Fonts/Cinzel-Medium.ttf");
    color: rgb(237, 238, 245);
    font-size: 32px;
    margin-bottom: 26px;
}

.management-columns {
    flex-direction: row;
}

.mgmt-column {
    margin: 0 26px;
}

.column-header {
    color: rgb(97, 98, 111);
    font-size: 16px;
    letter-spacing: 1px;
    margin-bottom: 10px;
}

.grid-header {
    color: rgb(97, 98, 111);
    font-size: 15px;
    letter-spacing: 1px;
    margin-top: 18px;
    margin-bottom: 10px;
}

/* ---------- Lista de Equipamiento ---------- */

.equipment-slots {
    flex-direction: column;
    width: 480px;
}

.equip-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 10px 5px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(48, 49, 66, 0.25);
}

.equip-row.no-border {
    border-bottom-width: 0;
}

.equip-row-label {
    color: rgb(111, 113, 125);
    font-size: 17px;
}

.equip-row-empty {
    color: rgb(83, 84, 97);
    font-size: 16px;
    -unity-font-style: italic;
}

.equip-row-item {
    flex-direction: row;
    align-items: center;
}

.equip-item-name {
    color: rgb(227, 228, 235);
    font-size: 16px;
    -unity-font-style: bold;
    margin-left: 8px;
}

.accent-dot {
    width: 10px;
    height: 10px;
    border-radius: 6px;
}

/* ---------- Grillas (mochila / stash) ---------- */

.grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.backpack-grid {
    width: 402px;
}

.stash-grid-big {
    width: 536px;
}

.item-slot {
    width: 60px;
    height: 60px;
    margin: 7px;
    background-color: rgba(29, 30, 41, 0.4);
    border-width: 1px;
    border-color: rgba(55, 57, 74, 0.35);
    border-radius: 6px;
    justify-content: center;
    align-items: center;
    overflow: hidden;
}

.item-slot:hover {
    border-color: rgba(237, 238, 245, 0.5);
}

.item-name {
    color: rgb(227, 228, 235);
    font-size: 13px;
    -unity-text-align: middle-center;
    white-space: normal;
    width: 100%;
    padding: 2px;
}

.item-qty {
    position: absolute;
    bottom: 2px;
    right: 4px;
    color: white;
    font-size: 12px;
    -unity-font-style: bold;
}

/* ---------- Acentos por slot / tipo de item ---------- */

.accent-dot.accent-green   { background-color: rgb(103, 210, 131); }
.accent-dot.accent-cyan    { background-color: rgb(62, 204, 226); }
.accent-dot.accent-violet  { background-color: rgb(181, 139, 249); }
.accent-dot.accent-gold    { background-color: rgb(228, 183, 80); }
.accent-dot.accent-amber   { background-color: rgb(237, 131, 94); }
.accent-dot.accent-loot    { background-color: rgb(226, 73, 71); }

.item-slot.accent-green  { background-color: rgba(103, 210, 131, 0.18); border-color: rgba(103, 210, 131, 0.55); }
.item-slot.accent-cyan   { background-color: rgba(62, 204, 226, 0.18); border-color: rgba(62, 204, 226, 0.55); }
.item-slot.accent-violet { background-color: rgba(181, 139, 249, 0.18); border-color: rgba(181, 139, 249, 0.55); }
.item-slot.accent-gold   { background-color: rgba(228, 183, 80, 0.18); border-color: rgba(228, 183, 80, 0.55); }
.item-slot.accent-amber  { background-color: rgba(237, 131, 94, 0.18); border-color: rgba(237, 131, 94, 0.55); }
.item-slot.accent-loot   { background-color: rgba(226, 73, 71, 0.18); border-color: rgba(226, 73, 71, 0.6); }

.hint {
    color: rgb(97, 98, 111);
    font-size: 14px;
    -unity-font-style: italic;
    margin-top: 22px;
}

.stash-close-btn {
    -unity-font-definition: url("/Assets/_Projec/Fonts/Manrope-Bold.ttf");
    align-self: center;
    width: auto;
    padding: 14px 36px;
    margin-top: 18px;
    font-size: 16px;
    letter-spacing: 1px;
    color: rgb(220, 221, 229);
    background-color: rgba(25, 26, 36, 0.5);
    border-width: 1px;
    border-color: rgba(95, 98, 117, 0.5);
    border-radius: 8px;
}

.stash-close-btn:hover {
    background-color: rgba(35, 36, 48, 0.7);
    border-color: rgba(181, 139, 249, 0.5);
}

.drag-ghost {
    position: absolute;
    width: 60px;
    height: 60px;
    background-color: rgba(40, 40, 60, 0.95);
    border-width: 1px;
    border-color: rgba(237, 238, 245, 0.6);
    border-radius: 6px;
    justify-content: center;
    align-items: center;
}