.hud-root {
    flex-grow: 1;
    justify-content: flex-end;
    align-items: center;
    padding-bottom: 30px;
}

/* --- Extracción --- */
.extraction-container {
    position: absolute;
    top: 40%;
    width: 360px;
    align-items: center;
    display: none;
}

.extraction-label {
    color: white;
    -unity-font-style: bold;
    font-size: 17px;
    margin-bottom: 6px;
    -unity-text-align: middle-center;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.9);
}

.extraction-bar-bg {
    width: 360px;
    height: 22px;
    background-color: rgba(0, 0, 0, 0.75);
    border-radius: 5px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.55);
    overflow: hidden;
}

.extraction-bar-fill {
    height: 100%;
    width: 0%;
    background-color: rgb(235, 195, 45);
}

/* --- Barras vida / maná --- */
.bars-container {
    width: 300px;
    margin-bottom: 12px;
}

.bar-bg {
    width: 300px;
    background-color: rgba(0, 0, 0, 0.7);
    border-radius: 5px;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0.85);
    overflow: hidden;
    justify-content: center;
    align-items: center;
}

.health-bar-bg {
    height: 24px;
    margin-bottom: 6px;
}

.mana-bar-bg {
    height: 18px;
}

.bar-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 100%;
}

.health-bar-fill {
    background-color: rgb(210, 45, 45);
}

.mana-bar-fill {
    background-color: rgb(55, 120, 230);
}

.bar-text {
    color: white;
    -unity-font-style: bold;
    font-size: 12px;
    -unity-text-align: middle-center;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.95);
}

/* --- Barra de habilidades --- */
.ability-bar {
    flex-direction: row;
}

.ability-slot {
    width: 58px;
    height: 58px;
    margin: 4px;
    background-color: rgba(18, 18, 28, 0.9);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.45);
    border-radius: 7px;
    justify-content: flex-end;
    align-items: flex-start;
    overflow: hidden;
}

.slot-key {
    color: white;
    font-size: 13px;
    -unity-font-style: bold;
    margin-left: 5px;
    margin-bottom: 3px;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.95);
}

.slot-cooldown {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    top: 0;
    background-color: rgba(0, 0, 0, 0.72);
    height: 0%;
}

/* --- Info de run (timer / peligro / contador) --- */
.run-info {
    position: absolute;
    top: 16px;
    width: 100%;
    align-items: center;
}

.run-timer {
    color: white;
    -unity-font-style: bold;
    font-size: 26px;
    -unity-text-align: middle-center;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.95);
}

.run-danger {
    color: rgb(235, 65, 65);
    -unity-font-style: bold;
    font-size: 19px;
    margin-top: 3px;
    display: none;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.95);
}

.run-counter {
    color: rgba(255, 255, 255, 0.9);
    font-size: 13px;
    margin-top: 3px;
    -unity-text-align: middle-center;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.95);
}