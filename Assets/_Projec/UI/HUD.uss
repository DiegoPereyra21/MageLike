.hud-root {
    flex-grow: 1;
    justify-content: flex-end;
    align-items: center;
    padding-bottom: 30px;
}

.bars-container {
    width: 300px;
    margin-bottom: 12px;
}

.bar-bg {
    width: 300px;
    background-color: rgba(0, 0, 0, 0.6);
    border-radius: 4px;
    overflow: hidden;
    justify-content: center;
    align-items: center;
}

.health-bar-bg {
    height: 22px;
    margin-bottom: 6px;
}

.mana-bar-bg {
    height: 16px;
}

.bar-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 100%;
}

.health-bar-fill {
    background-color: rgb(200, 40, 40);
}

.mana-bar-fill {
    background-color: rgb(50, 110, 220);
}

.bar-text {
    color: white;
    -unity-font-style: bold;
    font-size: 12px;
    -unity-text-align: middle-center;
}

.ability-bar {
    flex-direction: row;
}

.ability-slot {
    width: 56px;
    height: 56px;
    margin: 4px;
    background-color: rgba(20, 20, 30, 0.85);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.3);
    border-radius: 6px;
    justify-content: flex-end;
    align-items: flex-start;
    overflow: hidden;
}

.slot-key {
    color: white;
    font-size: 12px;
    -unity-font-style: bold;
    margin-left: 4px;
    margin-bottom: 2px;
}

.slot-cooldown {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    top: 0;
    background-color: rgba(0, 0, 0, 0.7);
    height: 0%;
}