.hud-root {
    flex-grow: 1;
    justify-content: flex-end;
    align-items: center;
    padding-bottom: 42px;
}

/* --- Extracción --- */
.extraction-container {
    position: absolute;
    top: 40%;
    width: 500px;
    align-items: center;
    display: none;
}

.extraction-label {
    color: white;
    -unity-font-style: bold;
    font-size: 24px;
    margin-bottom: 8px;
    -unity-text-align: middle-center;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.9);
}

.extraction-bar-bg {
    width: 500px;
    height: 31px;
    background-color: rgba(0, 0, 0, 0.75);
    border-radius: 7px;
    border-width: 3px;
    border-color: rgba(0, 0, 0, 0.9);
    overflow: hidden;
}

.extraction-bar-fill {
    height: 100%;
    width: 0%;
    background-color: rgb(235, 195, 45);
}

/* --- Barras vida / maná --- */
.bars-container {
    width: 420px;
    margin-bottom: 17px;
}

.bar-bg {
    width: 420px;
    background-color: rgba(0, 0, 0, 0.7);
    border-radius: 7px;
    border-width: 3px;
    border-color: rgba(0, 0, 0, 0.9);
    overflow: hidden;
    justify-content: center;
    align-items: center;
}

.health-bar-bg {
    height: 34px;
    margin-bottom: 8px;
}

.mana-bar-bg {
    height: 25px;
}

.bar-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 100%;
}

.health-bar-fill {
    background-color: rgb(210, 45, 45);
}

.mana-bar-fill {
    background-color: rgb(55, 120, 230);
}

.bar-text {
    color: white;
    -unity-font-style: bold;
    font-size: 17px;
    -unity-text-align: middle-center;
    text-shadow: 0 2px 3px rgba(0, 0, 0, 0.95);
}

/* --- Barra de habilidades --- */
.ability-bar {
    flex-direction: row;
}

.ability-slot {
    width: 81px;
    height: 81px;
    margin: 6px;
    background-color: rgba(18, 18, 28, 0.9);
    border-width: 3px;
    border-color: rgba(0, 0, 0, 0.9);
    border-radius: 10px;
    justify-content: flex-end;
    align-items: flex-start;
    overflow: hidden;
}

.slot-key {
    color: white;
    font-size: 18px;
    -unity-font-style: bold;
    margin-left: 7px;
    margin-bottom: 4px;
    text-shadow: 0 2px 3px rgba(0, 0, 0, 0.95);
}

.slot-cooldown {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    top: 0;
    background-color: rgba(0, 0, 0, 0.72);
    height: 0%;
}

/* --- Info de run (timer / peligro / contador) --- */
.run-info {
    position: absolute;
    top: 22px;
    width: 100%;
    align-items: center;
}

.run-timer {
    color: white;
    -unity-font-style: bold;
    font-size: 36px;
    -unity-text-align: middle-center;
    text-shadow: 0 3px 5px rgba(0, 0, 0, 0.95);
}

.run-danger {
    color: rgb(235, 65, 65);
    -unity-font-style: bold;
    font-size: 27px;
    margin-top: 4px;
    display: none;
    text-shadow: 0 2px 5px rgba(0, 0, 0, 0.95);
}

.run-counter {
    color: rgba(255, 255, 255, 0.9);
    font-size: 18px;
    margin-top: 4px;
    -unity-text-align: middle-center;
    text-shadow: 0 2px 3px rgba(0, 0, 0, 0.95);
}

.crosshair {
    width: 6px;
    height: 6px;
    background-color: rgba(255, 255, 255, 0.85);
    border-radius: 3px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.7);
}

.interact-prompt {
    position: absolute;
    top: 55%;
    width: 100%;
    -unity-text-align: middle-center;
    color: white;
    -unity-font-style: bold;
    font-size: 16px;
    text-shadow: 0 2px 3px rgba(0, 0, 0, 0.95);
    display: none;
}

.crosshair-container {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 40px;
    height: 40px;
    margin-left: -20px;
    margin-top: -20px;
    justify-content: center;
    align-items: center;
}

.dash-ring {
    position: absolute;
    width: 40px;
    height: 40px;
}

.hitmarker {
    position: absolute;
    width: 40px;
    height: 40px;
}

.stat-modifiers {
    position: absolute;
    top: 22px;
    right: 22px;
    align-items: flex-end;
}

.stat-modifier-entry {
    font-size: 14px;
    -unity-font-style: bold;
    margin-bottom: 3px;
    text-shadow: 0 2px 3px rgba(0, 0, 0, 0.95);
}

.stat-modifier-positive {
    color: rgb(90, 220, 110);
}

.stat-modifier-negative {
    color: rgb(230, 90, 90);
}