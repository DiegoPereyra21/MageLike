.hud-root {
    -unity-font-definition: url("/Assets/_Projec/Fonts/Manrope-Regular.ttf");
    flex-grow: 1;
    justify-content: flex-end;
    align-items: center;
    padding-bottom: 50px;
}

.danger-frame {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    border-width: 0px;
    border-color: rgba(255, 102, 97, 0.7);
    transition-property: border-width;
    transition-duration: 0.4s;
}

.danger-frame.active {
    border-width: 10px;
}

/* --- Extracción --- */
.extraction-container {
    position: absolute;
    top: 40%;
    width: 560px;
    align-items: center;
    display: none;
}

.extraction-label {
    color: rgb(237, 238, 245);
    -unity-font-style: bold;
    font-size: 28px;
    margin-bottom: 10px;
    -unity-text-align: middle-center;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.9);
}

.extraction-bar-bg {
    width: 560px;
    height: 30px;
    background-color: rgba(20, 21, 30, 0.85);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(68, 70, 88, 0.5);
    overflow: hidden;
}

.extraction-bar-fill {
    height: 100%;
    width: 0%;
    background-color: rgb(228, 183, 80);
}

/* --- Barras vida / maná --- */
.bars-container {
    width: 480px;
    margin-bottom: 16px;
}

.bar-bg {
    width: 480px;
    background-color: rgba(20, 21, 30, 0.85);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(68, 70, 88, 0.5);
    overflow: hidden;
    justify-content: center;
    align-items: center;
}

.health-bar-bg {
    height: 30px;
    margin-bottom: 7px;
}

.mana-bar-bg {
    height: 22px;
}

.bar-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 100%;
}

.health-bar-fill {
    background-color: rgb(226, 73, 71);
}

.mana-bar-fill {
    background-color: rgb(0, 171, 211);
}

.bar-text {
    color: rgb(237, 238, 245);
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    text-shadow: 0 2px 3px rgba(0, 0, 0, 0.95);
}

/* --- Barra de habilidades --- */
.ability-bar {
    flex-direction: row;
}

.ability-slot {
    width: 84px;
    height: 84px;
    margin: 7px;
    background-color: rgba(20, 21, 30, 0.85);
    border-width: 1px;
    border-color: rgba(68, 70, 88, 0.5);
    border-radius: 10px;
    justify-content: flex-end;
    align-items: flex-start;
    overflow: hidden;
    position: relative;
}

.ability-icon {
    position: absolute;
    top: 14px;
    left: 50%;
}

.icon-circle {
    width: 16px;
    height: 16px;
    margin-left: -8px;
    border-radius: 8px;
}

.icon-diamond {
    width: 14px;
    height: 14px;
    margin-left: -7px;
    rotate: 45deg;
}

.icon-square {
    width: 14px;
    height: 14px;
    margin-left: -7px;
    border-radius: 3px;
}

.icon-violet { background-color: rgb(181, 139, 249); }
.icon-green  { background-color: rgb(103, 210, 131); }
.icon-gold   { background-color: rgb(228, 183, 80); }
.icon-cyan   { background-color: rgb(62, 204, 226); }

.slot-key {
    color: rgb(210, 211, 219);
    font-size: 15px;
    -unity-font-style: bold;
    margin-left: 7px;
    margin-bottom: 4px;
    text-shadow: 0 2px 3px rgba(0, 0, 0, 0.95);
}

.slot-cooldown {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    top: 0;
    background-color: rgba(4, 4, 9, 0.72);
    height: 0%;
}

.slot-cd-text {
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    color: rgb(237, 238, 245);
    font-size: 18px;
    -unity-font-style: bold;
    text-shadow: 0 2px 3px rgba(0, 0, 0, 0.95);
    display: none;
}

/* --- Info de run --- */
.run-info {
    position: absolute;
    top: 26px;
    width: 100%;
    align-items: center;
}

.run-timer {
    color: rgb(237, 238, 245);
    -unity-font-style: bold;
    font-size: 42px;
    text-shadow: 0 3px 6px rgba(0, 0, 0, 0.95);
}

.run-danger {
    color: rgb(255, 102, 97);
    -unity-font-style: bold;
    font-size: 16px;
    letter-spacing: 2px;
    margin-top: 5px;
    display: none;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.95);
}

.run-counter {
    color: rgb(220, 221, 229);
    font-size: 16px;
    -unity-font-style: bold;
    margin-top: 3px;
    text-shadow: 0 2px 3px rgba(0, 0, 0, 0.95);
}

.crosshair {
    width: 6px;
    height: 6px;
    background-color: rgba(237, 238, 245, 0.9);
    border-radius: 3px;
    border-width: 1px;
    border-color: rgba(4, 4, 9, 0.7);
}

.interact-prompt {
    position: absolute;
    top: 55%;
    width: 100%;
    -unity-text-align: middle-center;
    color: rgb(237, 238, 245);
    -unity-font-style: bold;
    font-size: 19px;
    text-shadow: 0 2px 3px rgba(0, 0, 0, 0.95);
    display: none;
}

.crosshair-container {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 40px;
    height: 40px;
    margin-left: -20px;
    margin-top: -20px;
    justify-content: center;
    align-items: center;
}

.dash-ring {
    position: absolute;
    width: 40px;
    height: 40px;
}

.hitmarker {
    position: absolute;
    width: 40px;
    height: 40px;
}

.stat-modifiers {
    position: absolute;
    top: 26px;
    right: 26px;
    align-items: flex-end;
}

.stat-modifier-entry {
    font-size: 16px;
    -unity-font-style: bold;
    text-shadow: 0 2px 3px rgba(0, 0, 0, 0.95);
}

.stat-modifier-positive {
    color: rgb(80, 210, 100);
}

.stat-modifier-negative {
    color: rgb(240, 90, 88);
}

.damage-flash {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    border-width: 0px;
}

.damage-indicator {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}